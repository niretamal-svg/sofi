# ============================================================================
# Environment Configuration for Sofi Backend
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ============================================================================
# Firebase Configuration
# ============================================================================
# Your Google Cloud project ID
FIREBASE_PROJECT_ID=your-gcp-project-id

# ============================================================================
# MongoDB Configuration
# ============================================================================
# Connection URI for MongoDB
MONGODB_URI=mongodb://mongodb:27017

# Name of the database to use
MONGODB_DB_NAME=sofi_db

# Firebase service account credentials as JSON string
# Obtain from Google Cloud Console > Service Accounts > Create Key
# Must be a valid JSON string (all on one line in .env, but can be formatted here for clarity)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-gcp-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-gcp-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ============================================================================
# Google Gemini AI Configuration
# ============================================================================
# Get API key from https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# Stripe Payment Configuration
# ============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ============================================================================
# Encryption Configuration
# ============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: dev or prod
ENVIRONMENT=dev

# CORS Origins (comma-separated)
# For development: http://localhost:3000,http://localhost:8000
# For production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Optional: Server Configuration
# ============================================================================
# Set to true for development with auto-reload
DEBUG=true

# Set to true only when intentionally running the local demo login/mock token flow
ENABLE_MOCKS=false

# API prefix for routes (e.g., /api/v1)
API_PREFIX=/api/v1
